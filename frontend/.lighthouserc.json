{
  "ci": {
    "collect": {
      "staticDistDir": "./dist",
      "url": [
        "http://localhost/index.html"
      ],
      "numberOfRuns": 1,
      "settings": {
        "preset": "desktop",
        "skipAudits": [
          "uses-http2",
          "is-crawlable",
          "crawlable-anchors",
          "robots-txt",
          "canonical",
          "hreflang",
          "structured-data",
          "bf-cache"
        ]
      },
      "chromeFlags": "--no-sandbox --headless=new --disable-gpu --disable-dev-shm-usage"
    },
    "assert": {
      "assertions": {
        "categories:accessibility": [
          "error",
          { "minScore": 0.95 }
        ]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
